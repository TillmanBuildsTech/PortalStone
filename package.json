{
  "name": "portalstone",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm -w @portalstone/core test && npm -w @portalstone/agent test",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/agent/tsconfig.json --noEmit",
    "agent": "tsx packages/agent/src/main.ts",
    "mvp": "tsx packages/agent/src/main.ts --open",
    "scan": "tsx packages/agent/src/main.ts --once",
    "rebuild": "tsx packages/agent/src/main.ts --once --rebuild"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.6"
  }
}
