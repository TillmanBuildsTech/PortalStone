{
  "name": "portalstone",
  "private": true,
  "version": "0.1.0-beta.3",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm -w @portalstone/core test && npm -w @portalstone/agent test",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/agent/tsconfig.json --noEmit",
    "build": "node scripts/build-release.mjs",
    "release": "node scripts/release.mjs",
    "service:install": "node scripts/install-service.mjs",
    "agent": "tsx packages/agent/src/main.ts",
    "mvp": "tsx packages/agent/src/main.ts --open",
    "scan": "tsx packages/agent/src/main.ts --once",
    "rebuild": "tsx packages/agent/src/main.ts --once --rebuild",
    "addon:install": "node scripts/install-addon.mjs",
    "addon:package": "node scripts/package-addon.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "luaparse": "^0.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wasmoon": "^1.16.0"
  }
}
